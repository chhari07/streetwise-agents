# Copy this file to .env and fill in real values. Never commit .env.
ASI1_API_KEY=your-asi1-api-key-here
GRAHAK_SEED=write-a-long-random-secret-sentence-here
# Orders are demo orders until shop owners join (no shop is told, no money moves).
# 0 only changes the wording; real orders still need owner sign-up, alerts and payment.
STREETWISE_DEMO=1
# Live-location link the agent sends to buyers. Browsers allow GPS only on https or localhost, so for a phone
# run `cloudflared tunnel --url http://localhost:8091` and put its https address here.
# STREETWISE_PUBLIC_URL=https://your-name.trycloudflare.com
